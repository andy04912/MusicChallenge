ADMIN_PASSWORD=replace-with-a-long-unique-password
PORT=8080
DATA_DIR=./data
# Zeabur: NODE_ENV=production, DATA_DIR=/data, mount a persistent volume at /data.
# APP_ORIGIN=https://your-domain.zeabur.app

# Docker Compose local preview (separate frontend and API).
FRONTEND_PORT=8090
BIND_ADDRESS=127.0.0.1
APP_ENV=development
# For public HTTPS deployment: APP_ENV=production and APP_ORIGIN=https://your-domain
