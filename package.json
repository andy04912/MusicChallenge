{
  "name": "seoul-signal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "check": "node --check server.mjs && node --check charts.mjs && node --check scripts/dev.mjs && node --check src/lib/game-logic.js",
    "test": "npm run test:server && npm run test:ui",
    "catalog": "python scripts/catalog.py",
    "build": "node scripts/prepare-assets.mjs && vite build",
    "test:server": "node --test test/*.test.mjs",
    "test:ui": "vitest run",
    "format": "prettier --write src scripts/*.mjs vite.config.js"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "lighthouse": "^13.5.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
