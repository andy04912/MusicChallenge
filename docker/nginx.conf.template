server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;
    client_max_body_size 64k;

    # Resolve the private API hostname again after container replacement.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
    set $api_upstream "${API_UPSTREAM}";

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options DENY always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data: https://*.mzstatic.com; media-src https://*.mzstatic.com https://*.itunes.apple.com; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    gzip on;
    gzip_vary on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location ^~ /api/ {
        proxy_pass $api_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Connection "";
        # Keep browser Origin, Cookie and X-CSRF-Token unchanged.
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_cache off;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header Referrer-Policy;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Content-Security-Policy;
    }
    location = /api { return 404; }
    location = / { expires -1; try_files /index.html =404; }
    location = /index.html { expires -1; }
    location = /admin { expires -1; try_files /index.html =404; }
    location = /admin/ { expires -1; try_files /index.html =404; }
    location /assets/ { expires 1y; try_files $uri =404; }
    location /images/ { expires -1; try_files $uri =404; }
    location = /BARLOW-LICENSE.txt { try_files $uri =404; }
    # Never send the app shell for missing API, source or asset paths.
    location / { return 404; }
}
